  "repository": {
    "type": "git",
    "url": "https://github.com/jpscalero/ghostlink"
  },
  "dependencies": {
    "libsodium-wrappers-sumo": "^0.8.4",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "fake-indexeddb": "^6.2.5"
  }
