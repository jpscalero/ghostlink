    "test:identity": "node tests/test-identity.js",
    "test:ratchet": "node tests/test-double-ratchet.js",
    "test:db": "node tests/test-encrypted-db.js",
    "test:all": "node tests/test-sodium.js && node tests/test-x3dh-keystore.js && node tests/test-identity.js && node tests/test-double-ratchet.js && node tests/test-encrypted-db.js"
